# Gecko in.Touch 2 (local network — IP address of the in.Touch 2 module)
# GECKO_HOST=192.168.1.50

# Labcom PoolLab API
LABCOM_API_URL=https://backend.labcom.cloud/graphql
LABCOM_API_KEY=

# Shelly 3EM (local network)
SHELLY_HOST=http://192.168.1.100

# BlueConnect (not yet available)
BLUECONNECT_API_URL=https://api.blueconnect.io
BLUECONNECT_API_KEY=

# Data volume path (set to your NAS mount for persistent storage)
# Ugreen NAS example: DATA_PATH=/volume1/swimspa
DATA_PATH=./data

# Claude AI Assistant (uses local Claude Code subscription, no API key needed)
# Optional: set path to claude CLI if not in PATH
# CLAUDE_CLI_PATH=/usr/local/bin/claude
